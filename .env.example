HF_TOKEN=your_huggingface_token_here

SQS_QUEUE_URL=https://sqs.REGION.amazonaws.com/ACCOUNT_ID/QUEUE_NAME
S3_BUCKET_NAME=your-s3-bucket-name
DYNAMODB_TABLE_NAME=your-dynamodb-table-name
UNIQUE_MEETINGS_TABLE_NAME=your-unique-meetings-table-name

AWS_REGION=us-east-1

MAX_RETRIES=3
VISIBILITY_TIMEOUT=3600
ONE_SHOT_MODE=true
NOVA_ENHANCED_EMBEDDINGS=true
# Optional: let Nova group segments by topic instead of the rule-based chunker
# (falls back to the rule-based chunker on any failure).
NOVA_DIRECT_CHUNKING=false
WHISPER_LANGUAGE=fr

# Only used by the EC2 helper scripts (simple-ecs.sh, user-data)
ECS_CLUSTER_NAME=your-ecs-cluster-name
